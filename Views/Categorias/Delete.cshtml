@model Tienda.Models.Categoria

@{
    ViewData["Title"] = "Eliminar";
}

<style>
    .btn-pastel {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 7px;
        border: 1px solid;
        text-decoration: none;
        font-weight: 500;
        cursor: pointer;
    }

    .bg-rosado {
        background-color: #F8D7DA;
        color: #843B45;
        border-color: #EDBFC5;
    }

    .bg-gris {
        background-color: #E8E8E8;
        color: #555555;
        border-color: #D0D0D0;
    }

    .botones {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        align-items: center;
    }
</style>

<h1>Eliminar</h1>

<h3>¿Estás seguro de que deseas eliminar esta categoría?</h3>

<div>
    <h4>Categoria</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Descripcion)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <div class="botones">
            <input type="submit" value="Eliminar categoría" class="btn-pastel bg-rosado" />

            <a asp-action="Index" class="btn-pastel bg-gris">Volver a la lista</a>
        </div>
    </form>
</div>