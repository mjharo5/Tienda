@model Tienda.Models.Producto

@{
    ViewData["Title"] = "Create";
}

<style>
    .btn-pastel {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 7px;
        border: 1px solid;
        text-decoration: none;
        font-weight: 500;
        cursor: pointer;
    }

    .bg-celeste {
        background-color: #D6EAF8;
        color: #285675;
        border-color: #B9D9ED;
    }

    .bg-gris {
        background-color: #E8E8E8;
        color: #555555;
        border-color: #D0D0D0;
    }

    .botones {
        display: flex;
        gap: 10px;
        margin-top: 15px;
        align-items: center;
    }
</style>

<h1>Create</h1>

<h4>Producto</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nombre" class="control-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Precio" class="control-label"></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Stock" class="control-label"></label>
                <input asp-for="Stock" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoriaId" class="control-label"></label>
                <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId">
                    <option value="">-- Seleccione una Categoría --</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>

            <div class="botones">
                <input type="submit" value="Crear producto" class="btn-pastel bg-celeste" />

                <a asp-action="Index" class="btn-pastel bg-gris">Volver a la lista</a>
            </div>
        </form>
    </div>
</div>