@model IEnumerable<Tienda.Models.Producto>

@{
    ViewData["Title"] = "Index";
}

<style>
    .btn-pastel {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 7px;
        border: 1px solid;
        text-decoration: none;
        font-weight: 500;
    }

    .bg-celeste {
        background-color: #D6EAF8;
        color: #285675;
        border-color: #B9D9ED;
    }

    .bg-amarillo {
        background-color: #FFF0C2;
        color: #80621B;
        border-color: #F2DEA0;
    }

    .bg-morado {
        background-color: #E6D9F2;
        color: #62457D;
        border-color: #D2BDE8;
    }

    .bg-rosado {
        background-color: #F8D7DA;
        color: #843B45;
        border-color: #EDBFC5;
    }
</style>

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn-pastel bg-celeste">+ Crear nuevo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Precio)</th>
            <th>@Html.DisplayNameFor(model => model.Stock)</th>
            <th>@Html.DisplayNameFor(model => model.Categoria)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(model => item.Nombre)</td>
                <td>@Html.DisplayFor(model => item.Precio)</td>
                <td>@Html.DisplayFor(model => item.Stock)</td>
                <td>@item.Categoria?.Nombre</td>
                <td style="text-align: right; padding-right: 5px; white-space: nowrap;">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-pastel bg-amarillo">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-pastel bg-morado">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-pastel bg-rosado">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
