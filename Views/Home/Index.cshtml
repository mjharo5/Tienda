@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-5">
    <h1 class="display-4">Bienvenido a nuestra tienda</h1>
    <p class="lead text-muted">
        Consulta el catálogo de productos organizados por categoría.
    </p>
    <div class="mt-4">
        <a asp-controller="Productos" asp-action="Index" class="btn btn-lg btn-soft px-5">Ver productos</a>
        <a asp-controller="Categorias" asp-action="Index" class="btn btn-lg btn-soft px-5 ms-2">Ver categorías</a>
    </div>
</div>